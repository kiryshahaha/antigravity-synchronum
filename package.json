{
  "name": "antigravity-synchronum",
  "version": "1.1.0",
  "description": "Cross-device conversation & artifact synchronization for Google Antigravity 2.0 with Zero-Knowledge E2EE.",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "synchronum": "./dist/cli.js",
    "antigravity-synchronum": "./dist/cli.js"
  },
  "files": [
    "dist",
    "sidecar",
    "install.bat",
    "install.sh",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsc",
    "start": "node --experimental-sqlite ./dist/cli.js",
    "dev": "tsx --experimental-sqlite ./src/cli.ts",
    "test": "tsx --experimental-sqlite --test test/**/*.test.ts",
    "bundle": "npx tsx scripts/build-bundles.ts",
    "setup": "node --experimental-sqlite ./dist/cli.js setup",
    "uninstall": "node --experimental-sqlite ./dist/cli.js uninstall"
  },
  "keywords": [
    "antigravity",
    "gemini",
    "sync",
    "sidecar",
    "e2ee",
    "google-drive"
  ],
  "author": "kiryshahaha",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
